# Copy to .env and fill in real values. Never commit .env.

# Domain the app is reachable at (Caddy uses this for automatic HTTPS).
# Set to ":80" during testing without TLS.
DOMAIN=hundefutter.example.com

# VAPID keypair for Web Push (RFC 8292).
# Generate once with:
#   docker run --rm node:20-alpine npx -y web-push generate-vapid-keys --json
# and paste the two values here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Timezone for the feeding-reminder cron.
TIMEZONE=Europe/Berlin
