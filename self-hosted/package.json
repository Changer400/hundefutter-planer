{
  "name": "hundefutter-planer-self-hosted",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Node.js port of the Cloudflare backend (API + Web Push cron).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.5.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
